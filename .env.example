# Credenciais do Mongo usadas por slink-mongodb / slink-app (docker-compose.deploy.yaml)
MONGO_USER=root
MONGO_PASSWORD=troque-esta-senha

# Carimbada automaticamente pelo devops/ci-cd.sh a cada deploy — não precisa
# setar manualmente na primeira vez, o script adiciona/atualiza essa linha.
SLINK_VERSION=0.0.0
